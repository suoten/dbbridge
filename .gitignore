# ========================================
# DBBridge .gitignore
# ========================================

# ---- 内部规划文档（不公开）----
DBBridge规划文档.md
*.规划文档.md
*_规划文档*.md

# ---- 构建产物 ----
build/bin/
build/windows/
build/darwin/
build/linux/
dist/
release/
release-build.log
release-log.txt
release_build.log

# ---- 前端 ----
frontend/node_modules/
frontend/dist/
frontend/package.json.md5

# ---- 二进制文件 ----
*.exe
*.exe~
*.dll
*.so
*.dylib
dbbridge
dbbridge.exe
serverguard-*

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo
*~
*.tmp

# ---- Go ----
vendor/

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 配置 / 环境变量 ----
*.env
*.local
*.secret

# ---- 测试临时数据 ----
testdata/
*.db
*.db-journal
*.db-wal
*.db-shm

# ---- 日志 ----
*.log
tmp/
